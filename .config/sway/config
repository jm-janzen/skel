include /etc/sway/config.d/*
include /etc/sway/config-vars.d/*

include ~/.config/sway/bindings
# TODO Make a script to switch between ({office,home}-docked, and undocked)
# TODO Try out autorandr (can't believe I forgot about that tool...)
include ~/.config/sway/set-output

font pango:monospace 10

# Fixes issue with cursor disappearing over images in Firefox
exec_always swaymsg 'seat * xcursor_theme Adwaita 24'

# exec_always, to run of refresh (for randr changes)
# Kill swaybg before exec to prevent duplicates (really slows down after a while!)
exec_always killall swaybg
exec_always --no-startup-id swaybg --mode tile --image ~/Pictures/bg

# Lock after 5 minutes of inactivity
# FIXME Turn off monitor after 3, or screensaver, first
exec swayidle -w timeout 300 'swaylock -f -c 000000'

# Sway Notification Center
#   https://github.com/ErikReider/SwayNotificationCenter
## Notification Daemon + Toggle control center binding
exec swaync
bindsym $mod+Shift+n exec swaync-client -t -sw

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

smart_gaps on
gaps inner 13

# Open certain application in specific, named workspaces
# Discover the "class" of an applicationwith:
#
#   xprop | grep WM_CLASS | awk '{ print $4 }'
#
assign [class="thunderbird"] number 10 mail
assign [class="QuiteRss"]    number 11 rss
assign [class="Signal"]      number 12 chat
assign [class="discord"]     number 12 chat


exec_always --no-startup-id nm-applet
bar {
    swaybar_command waybar
}

input "11311:40:SNSL0028:00_2C2F:0028_Touchpad" {
    dwt enabled
    tap enabled
}

# class                 border  backgr. text    indicator child_border
client.focused          #9cff00 #436d00 #dbffa3 #2e9ef4   #1a3300
