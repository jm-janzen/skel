include /etc/sway/config.d/*
include /etc/sway/config-vars.d/*

include ~/.config/sway/bindings
include ~/.config/sway/set-output

# super / meta
set $mod Mod4

font pango:monospace 10

# exec_always, to run of refresh (for randr changes)
exec_always --no-startup-id swaybg --mode tile --image ~/Pictures/bg

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

smart_gaps on
gaps inner 13

# Open certain application in specific, named workspaces
# Discover the "class" of an applicationwith:
#
#   xprop | grep WM_CLASS | awk '{ print $4 }'
#
assign [class="thunderbird"] number 10 mail
assign [class="QuiteRss"]    number 11 rss
assign [class="Signal"]      number 12 chat
assign [class="discord"]     number 12 chat


exec_always --no-startup-id nm-applet
bar {
    swaybar_command waybar
}

# This is for sway(land)
input "11311:40:SNSL0028:00_2C2F:0028_Touchpad" {
    dwt enabled
    tap enabled
}

